# ============================================================
# Grafton Towboat Order — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ----- Supabase -----
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhb...your-service-role-key

# ----- Resend (Email) -----
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_...your-resend-api-key
# Verified sender domain — must match a domain verified in Resend
EMAIL_FROM=orders@your-verified-domain.com

# ----- Business -----
# Primary email that receives all new orders
BUSINESS_EMAIL=GraftonTowboatServices@gmail.com
# Optional comma-separated CC recipients
ORDER_EMAIL_CC=

# ----- Admin Auth -----
# The password to access /admin
ADMIN_PASSWORD=change-me-before-deploy
# A long random secret string used to validate admin sessions
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=replace-with-a-long-random-secret

# ----- App -----
# Your production Vercel URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
