{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/orders/[id]/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/orders/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/catalog-sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/catalog-rails/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/catalog-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/catalog-rails",
      "schedule": "40 7 * * *"
    }
  ]
}
